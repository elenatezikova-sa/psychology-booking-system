' ====== ЛЕГЕНДА ЦВЕТОВ ======
' Синий — внутренняя система MindSpace
' Зелёный — пользователи/персоны
' Серый — внешние системы
' Оранжевый — регуляторы/ограничения

skinparam rectangle {
  RoundCorner 12
}

